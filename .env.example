# ---------------------------------------------------------------------------
# AI Capsule - environment variable NAMES ONLY.
# Copy to ".env" for local development and fill in your own values.
# Never commit the real ".env" file or any real secret value.
# ---------------------------------------------------------------------------

# Port the Express server listens on (Render sets this automatically).
PORT=3000

# Secret used to sign and verify the application JWT.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# GitHub OAuth app credentials (Settings > Developer settings > OAuth Apps).
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret

# Public base URL of the app. Used to build the OAuth callback URL.
# Local:      http://localhost:3000
# Deployed:   https://your-app-name.onrender.com
APP_BASE_URL=http://localhost:3000

# Where the SQLite database file is written.
DATABASE_FILE=./data/capsules.db

# Set to "production" when deployed.
NODE_ENV=development

# The JWT cookie is Secure by default. Set to "false" ONLY if you need to test
# over plain http:// locally in a browser that rejects Secure cookies.
# COOKIE_SECURE=false
